# Application Configuration
APP_NAME="Multimodal Document Intelligence & RAG Assistant"
ENVIRONMENT="development"
DEBUG=True
API_V1_PREFIX="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./data/rag_assistant.db"

# Storage Configuration
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf", "png", "jpg", "jpeg", "docx"]

# Vector Database (ChromaDB) Configuration
CHROMA_PERSIST_DIRECTORY="./chroma_data"
CHROMA_COLLECTION_NAME="multimodal_rag_chunks"

# AI / Model Providers
# LLM Provider: "openai" or "mock" (for testing without API keys)
LLM_PROVIDER="openai"
OPENAI_API_KEY=""
LLM_MODEL="gpt-4o-mini"
VISION_MODEL="gpt-4o-mini"

# Embeddings Configuration
# EMBEDDING_PROVIDER: "openai" or "huggingface"
EMBEDDING_PROVIDER="huggingface"
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"

# OCR Configuration
TESSERACT_CMD="tesseract"
ENABLE_OCR=True

# RAG Settings
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=5
